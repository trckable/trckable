{
  "name": "trckable",
  "version": "0.1.0",
  "description": "Tiny, open-source web analytics that shows which traffic pays. Peekaboo. Every visit counted.",
  "keywords": [
    "analytics",
    "web-analytics",
    "privacy",
    "self-hosted",
    "revenue-attribution",
    "react",
    "nextjs",
    "trckable",
    "mcp",
    "model-context-protocol"
  ],
  "homepage": "https://trckable.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trckable/trckable.git",
    "directory": "packages/trckable"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "trckable": "dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@trckable/tracker": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
