    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@trckable/tracker": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "iso-3166-1": "^2.1.1",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "world-atlas": "^2.0.2"
  }
}
