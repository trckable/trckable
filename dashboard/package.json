{
  "name": "@trckable/dashboard",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/precompress.mjs && node scripts/size.mjs",
    "build:map": "node scripts/build-map.mjs",
    "build:globe": "node scripts/build-globe.mjs",
    "typecheck": "tsc --noEmit",
